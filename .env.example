# Any S3-compatible storage: Cloudflare R2, AWS S3, Backblaze B2, Supabase Storage...
S3_BUCKET=my-files
S3_REGION=auto
# Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com   (leave empty for AWS S3)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Password to open the site (required, otherwise anyone with the URL could use it)
APP_PASSWORD=change-me
PORT=3000
